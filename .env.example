RIDE_PORT=3007

# Base "invoicing" de Infrastructure/ (usuario ride, solo lectura)
RIDE_MONGO_URL=mongodb://ride:CLAVE@mongo:27017/invoicing?authSource=admin&replicaSet=rs0

# Token de este servicio (header X-Token-Admin)
RIDE_ADMIN_TOKEN=

# Configuracion: de ahi sale el logo de cada empresa
CONFIG_URL=http://config:3003
CONFIG_ADMIN_TOKEN=

# Opcionales
# CHROMIUM_PATH=/usr/bin/chromium
# RIDE_MAX_PARALLEL=4
# CONFIG_TIMEOUT_MS=5000

# Carpeta del equipo donde queda una copia de cada RIDE generado
# (<ruc>/<fecha>/<numero>.pdf). Usuario y grupo del equipo (id -u / id -g)
# para que los archivos queden a su nombre.
# RIDE_FOLDER_HOST=/home/usuario/Descargas/rides
# RIDE_UID=1000
# RIDE_GID=1000
